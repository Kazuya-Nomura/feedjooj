		text_input_trigger: function() {
			if (this.og_imported != true && this.active_media == null) {
				if (this.input_timeout) {
					clearTimeout(this.input_timeout);
				}

				this.input_timeout = setTimeout(this.fetchOgData, 500);
			}

			var text_val = this.text;

			this.mentions.users = [];
			this.mentions.pages = [];
			this.hashtags.tags = [];

			var hashtag_match   = text_val.match(/#\w+$/);
			var mention_match   = text_val.match(/@\w+$/);
			var symbol_match    = text_val.match(/\$\w+$/);

			if (hashtag_match) {
				var hashtag_kw = hashtag_match[0].replace('#', '');
				this.fetch_hashtags_ac(hashtag_kw);
			}

			else if (mention_match) {
				var mention_kw = mention_match[0].replace('@', '');
				this.fetch_mentions_ac(mention_kw);
			}

			else if (symbol_match) {
				var symbol_kw = symbol_match[0].replace('$', '');
				this.fetch_pages_ac(symbol_kw);
			}
		},
