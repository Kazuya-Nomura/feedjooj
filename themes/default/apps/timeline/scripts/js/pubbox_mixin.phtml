					form_data.append('keyword', kw);
					form_data.append('hash', "<?php echo fetch_or_get($cl['csrf_token'],'none'); ?>");

					_app_.autocomplete_processing = true;

					$.ajax({
						url: '<?php echo cl_link("native_api/main/search_hashtags_ac"); ?>',
						type: 'POST',
						dataType: 'json',
						enctype: 'multipart/form-data',
						data: form_data,
						cache: false,
				        contentType: false,
				        processData: false,
				        beforeSend: function() {
							_app_.hashtags.tags = [];
				        },
						success: function(data) {
							if (data.status == 200) {
								_app_.hashtags.tags = data.tags;
							}
						},
						complete: function() {
							_app_.autocomplete_processing = false;
						}
					});
				}
			}
		},
		hashtag_autocomplete: function(tag_text = '') {
			var text_val = this.text;
			var hashtag_match = text_val.match(/#\w+$/);

			if (hashtag_match) {
				var new_text = text_val.replace(hashtag_match[0], '#' + tag_text);
				this.text = new_text + ' ';
			}

			this.hashtags.tags = [];
		},
		mention_autocomplete: function(uname = '') {
			var text_val = this.text;
			var mention_match = text_val.match(/@\w+$/);

			if (mention_match) {
				var new_text = text_val.replace(mention_match[0], '@' + uname);
				this.text = new_text + ' ';
			}

			this.mentions.users = [];
		},
		page_autocomplete: function(uname = '') {
			var text_val = this.text;
			var symbol_match = text_val.match(/\$\w+$/);

			if (symbol_match) {
				var new_text = text_val.replace(symbol_match[0], '$' + uname);
				this.text = new_text + ' ';
			}

			this.mentions.pages = [];
		},
		emoticon_insert: function(icon = null) {
			if (icon) {
				this.text = this.text + icon;
			}

			this.emoticons_picker.status = false;
		},
		publish: function($event = null) {
			var _app_     = this;
			var form_data = new FormData(_app_.$el);

			if (!_app_.submitting && _app_.valid_form) {
				_app_.submitting = true;

				$(_app_.$el).ajaxSubmit({
					url: '<?php echo cl_link("native_api/main/publish_post"); ?>',
					type: 'POST',
					dataType: 'json',
					beforeSend: function() {
						SMColibri.progress_bar("show");
					},
					success: function(data) {

						if (data.status == 200) {
							_app_.text = "";
							_app_.images = [];
							_app_.video = {};
							_app_.audio = {};
							_app_.music = {};
							_app_.document = {};
							_app_.poll = [];
							_app_.active_media = null;
							_app_.gif_source = null;
							_app_.og_imported = false;
							_app_.og_data = {};
							_app_.og_hidden = [];
							_app_.disable_ctrls();

							cl_bs_notify("<?php echo cl_translate('Post published successfully'); ?>", 3000, "success");

							if (SMColibri.is_home) {
								//SMColibri.reload();
							}

							if (SMColibri.curr_pn == 'thread') {
								SMColibri.reload();
							}

							else if (SMColibri.curr_pn == 'profile') {
								if (typeof SMColibri.app.reload_posts === 'function') {
									SMColibri.app.reload_posts();
								}
							}

							if ($('#add_new_post').hasClass('show')) {
								$('#add_new_post').modal('hide');
							}

							if ($('#add_new_post_reply').hasClass('show')) {
								$('#add_new_post_reply').modal('hide');
							}

							if (document.getElementsByClassName('pubbox-open-graph').length > 0) {
								document.getElementsByClassName('pubbox-open-graph')[0].style.display = 'none';
							}
						}

						else {
							if (data.error) {
								cl_bs_notify(data.error, 3000, "danger");
							}

							else {
								SMColibri.errorMSG();
							}
						}
					},
					complete: function() {
						_app_.submitting = false;
						SMColibri.progress_bar("end");
					}
				});
			}

			$event.preventDefault();
			return false;
		}
	}
});