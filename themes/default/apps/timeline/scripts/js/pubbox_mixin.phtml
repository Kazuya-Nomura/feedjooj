		fetchOgData: function() {
			var url_regex    = /https?:\/\/(www\.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)?/gi;
			var matched_urls = this.text.match(url_regex);
			var _app_        = this;

			if (matched_urls) {
				if (this.og_imported != true || matched_urls.join('') != _app_.og_data.text) {
					var form_data = new FormData();

					form_data.append('urls', matched_urls.join(' '));
					form_data.append('hash', "<?php echo fetch_or_get($cl['csrf_token'],'none'); ?>");

					$.ajax({
						url: '<?php echo cl_link("native_api/main/og_import"); ?>',
						type: 'POST',
						dataType: 'json',
						enctype: 'multipart/form-data',
						data: form_data,
						cache: false,
				        contentType: false,
				        processData: false,
				        beforeSend: function() {
							_app_.og_imported = false;
				        },
						success: function(data) {
							if (data.status == 200) {
								_app_.og_data = data.data;
								_app_.og_imported = true;
							}
						}
					});
				}
			}

			else {
				_app_.og_imported = false;
			}
		},
		rm_preview_og: function() {
			this.og_hidden.push(this.og_data.url);
		},
		disable_ctrls: function() {
			if (this.active_media) {
				if (this.active_media == 'image') {
					this.video_ctrl = false;
					this.audio_ctrl = false;
					this.music_ctrl = false;
					this.poll_ctrl  = false;
					this.doc_ctrl   = false;
					this.gif_ctrl   = false;
				}

				else if (this.active_media == 'video') {
					this.image_ctrl = false;
					this.audio_ctrl = false;
					this.music_ctrl = false;
					this.poll_ctrl  = false;
					this.doc_ctrl   = false;
					this.gif_ctrl   = false;
				}

				else if (this.active_media == 'audio') {
					this.video_ctrl = false;
					this.image_ctrl = false;
					this.music_ctrl = false;
					this.poll_ctrl  = false;
					this.doc_ctrl   = false;
					this.gif_ctrl   = false;
				}

				else if (this.active_media == 'music') {
					this.video_ctrl = false;
