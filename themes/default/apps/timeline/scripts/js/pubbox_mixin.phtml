		start_audio_rec: function(event = false) {
			var _app_ = this;

			if (cl_empty(_app_.active_media) && navigator.mediaDevices) {
				if (cl_empty(_app_.audio_rec.is_recording)) {
					navigator.mediaDevices.getUserMedia({
						audio: true
					}).then(function(stream) {
						var rec = new MediaRecorder(stream);

						rec.ondataavailable = function(e) {
							var audio_file = new File([e.data], "voice_note.mp3", {
								type: "audio/mp3",
								lastModified: Date.now()
							});

							if (audio_file && SMColibri.max_upload(audio_file.size)) {
								var form_data = new FormData();
								form_data.append('audio', audio_file);
								form_data.append('hash', "<?php echo fetch_or_get($cl['csrf_token'],'none'); ?>");

								$.ajax({
									url: '<?php echo cl_link("native_api/main/upload_post_audio"); ?>',
									type: 'POST',
									dataType: 'json',
									enctype: 'multipart/form-data',
									data: form_data,
									cache: false,
									async: false,
							        contentType: false,
							        processData: false,
							        timeout: 600000,
							        beforeSend: function() {
										_app_.submitting = true;				        	
							        },
									success: function(data) {
										if (data.status == 200) {
											_app_.audio = data.audio;
										}
										else if(data.err_code == "total_limit_exceeded") {
											cl_bs_notify("<?php echo cl_translate('You cannot attach more than 1 audio file to this post.'); ?>", 3000, "danger");
										}
										else {
											SMColibri.errorMSG();
										}
									},
									complete: function() {
										if ($.isEmptyObject(_app_.audio) != true && cl_empty(_app_.active_media)) {
											_app_.active_media = "audio";
										}

										_app_.disable_ctrls();
										_app_.submitting = false;
									}
								});
							}

							stream.getAudioTracks().forEach(function(track) {
								track.stop();
							});
						};

						_app_.audio_rec.recorder = rec;
						_app_.audio_rec.is_recording = true;
						_app_.audio_rec.record_time = 0;
						_app_.audio_rec.record_ftime = "00:00";
						_app_.audio_rec.record_timeint = setInterval(function() {
							_app_.audio_rec.record_time += 1;

							var mm = Math.floor(_app_.audio_rec.record_time / 60);
							var ss = _app_.audio_rec.record_time - (mm * 60);

							if (mm < 10) {
								mm = "0" + mm;
							}

							if (ss < 10) {
								ss = "0" + ss;
							}

							_app_.audio_rec.record_ftime = mm + ":" + ss;

							if (_app_.audio_rec.record_time >= parseInt(_app_.audio_rec.max_length)) {
								_app_.finish_audio_rec();
							}

						}, 1000);

						rec.start();

					}).catch(function(error) {
						console.log('Error accessing microphone:', error);
						cl_bs_notify("<?php echo cl_translate('Error accessing your microphone. Please check your permissions.'); ?>", 5000, "danger");
					});
				} 

				else {
					_app_.finish_audio_rec();
				}
			}
		},
		finish_audio_rec: function() {
			if (this.audio_rec.is_recording) {
				this.audio_rec.recorder.stop();
				this.audio_rec.is_recording = false;
				clearInterval(this.audio_rec.record_timeint);
			}
		},
		cancel_audio_rec: function() {
			if (this.audio_rec.is_recording) {
				this.audio_rec.is_recording = false;
				this.audio_rec.record_time = 0;
				this.audio_rec.record_ftime = "00:00";
				clearInterval(this.audio_rec.record_timeint);
			}
		},
